# ============================================================
# glitz-quant environment configuration
# ============================================================
# Copy to .env and fill in real values. NEVER commit .env.
# `.env` is in .gitignore. If you ever leak a key, rotate
# immediately and revoke at the source.
# ============================================================

# -------- Runtime --------
GLITZ_ENV=development                 # development | staging | production
GLITZ_MODE=paper                      # backtest | paper | live
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                       # json | console

# -------- Storage --------
# Supabase (Postgres + Auth + Storage + Realtime + pgvector for RAG)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-side only, full access
SUPABASE_DB_URL=                      # postgres://... direct connection

# Redis — used for hot cache, pub/sub, rate limiting, deduplication
# Upstash (serverless) for prod, local docker for dev
REDIS_URL=redis://localhost:6379/0

# -------- LLM providers --------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                       # optional, also used for OpenRouter compat
GOOGLE_API_KEY=                       # Gemini via AI Studio
GROQ_API_KEY=
XAI_API_KEY=                          # Grok
OPENROUTER_API_KEY=                   # unified fallback

# Default LLM routing — pick a primary, OpenRouter as fallback
LLM_PRIMARY=anthropic                 # anthropic | google | groq | xai | openrouter
LLM_FALLBACK=openrouter

# -------- Market data --------
COINGECKO_API_KEY=
DATABENTO_API_KEY=
TARDIS_API_KEY=                       # optional, only if you buy tier above free
CRYPTOCOMPARE_API_KEY=
PYTH_HERMES_URL=https://hermes.pyth.network

# -------- CEX exchanges --------
# Coinbase Advanced Trade
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=                  # legacy Pro accounts only

# Kraken
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Binance.US (US-resident accounts)
BINANCE_US_API_KEY=
BINANCE_US_API_SECRET=

# Gemini (the exchange)
GEMINI_API_KEY=
GEMINI_API_SECRET=

# Crypto.com
CRYPTOCOM_API_KEY=
CRYPTOCOM_API_SECRET=

# -------- DEX / on-chain --------
# Solana — hot wallet for execution ONLY. Cap balance in config/risk.yaml.
SOLANA_RPC_URL=                       # Helius / QuickNode endpoint
SOLANA_HOT_WALLET_PRIVATE_KEY=        # base58 or json array — KEEP SECRET
SOLANA_TREASURY_PUBKEY=               # hardware wallet pubkey, sweeps go here
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Ethereum / EVM
EVM_RPC_URL=                          # Alchemy / QuickNode
EVM_HOT_WALLET_PRIVATE_KEY=
EVM_TREASURY_ADDRESS=                 # hardware wallet, receives sweeps

# Hyperliquid (uses an "API wallet" derived from main wallet — don't put main key here)
HYPERLIQUID_API_PRIVATE_KEY=
HYPERLIQUID_ACCOUNT_ADDRESS=          # the main wallet that owns the API agent

# -------- Notifications + monitoring --------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                     # your personal chat or alerts channel
DISCORD_WEBHOOK_URL=
SENTRY_DSN=
GRAFANA_API_KEY=                      # optional, only if using Grafana Cloud

# -------- Email (alerts, signups) --------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=

# -------- API server --------
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=                       # generate with: openssl rand -hex 32
CORS_ORIGINS=http://localhost:3000

# -------- Safety flags --------
# All three must be true to send a real order. The OMS checks all three.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRM_PHRASE=          # must match phrase in risk.yaml
LIVE_TRADING_MAX_NOTIONAL_USD=0       # hard ceiling per order, USD

# Kill-switch file path — orchestrator polls this. If it exists, halt.
KILL_SWITCH_PATH=/var/run/glitz-quant/HALT
